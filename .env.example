# InsightOps environment variables
# Copy this file to `.env` (local development) and fill in values.
# NEVER commit the real .env file. All values here are placeholders.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Runtime environment: dev | prod
APP_ENV=dev
# Human/automation-facing service name used in logs
SERVICE_NAME=insightops-api
# Git commit hash of the deployed build (injected by CI; "dev" locally)
COMMIT_HASH=dev
# Root log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Redis / Dramatiq broker
# ---------------------------------------------------------------------------
# Local Docker Compose uses host `redis`; plain local runs use `localhost`.
REDIS_URL=redis://localhost:6379/0
# Dramatiq retry policy (see PROJECT_PLAN Phase 6)
DRAMATIQ_MAX_RETRIES=3
DRAMATIQ_MIN_BACKOFF=1000
DRAMATIQ_MAX_BACKOFF=30000

# ---------------------------------------------------------------------------
# DeepSeek AI investigation
# ---------------------------------------------------------------------------
# Leave empty to disable LLM calls (investigations return a degraded result).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_TOKENS=1024

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated list of allowed origins for the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---------------------------------------------------------------------------
# Error aggregation / retrieval
# ---------------------------------------------------------------------------
# TTL (seconds) for temporary aggregation state stored in Redis.
ERROR_AGGREGATION_TTL=86400
# TTL (seconds) for investigation results stored in Redis.
INVESTIGATION_TTL=3600
# Maximum number of evidence items sent to the LLM.
RETRIEVAL_MAX_ITEMS=25
# Maximum total characters of evidence sent to the LLM.
RETRIEVAL_MAX_CHARS=12000

# ---------------------------------------------------------------------------
# Deployment (used by CI / production scripts — see .gitlab-ci.yml)
# ---------------------------------------------------------------------------
# GitLab project path, e.g. your-name/insight-ops
CI_PROJECT_PATH=
# Base URL of the deployed API used by smoke tests, e.g. https://api.example.com
DEPLOYMENT_URL=

# AWS (used by CI deployment jobs; prefer IAM roles on EC2 itself)
AWS_DEFAULT_REGION=eu-west-1
S3_FRONTEND_BUCKET=insight-ops-frontend
CLOUDFRONT_DISTRIBUTION_ID=
EC2_HOST=
