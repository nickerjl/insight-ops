# InsightOps production environment (.env.prod)
# Uploaded to /opt/insight-ops/.env.prod on EC2 by the deploy script.
# NEVER commit this file. Copy from deploy/.env.prod.example.

APP_ENV=prod
SERVICE_NAME=insightops-api
# Injected by CI: the exact commit SHA of the deployed image.
COMMIT_HASH=CHANGE_ME
LOG_LEVEL=INFO

# Redis inside the compose network.
REDIS_URL=redis://redis:6379/0

# Dramatiq retry policy.
DRAMATIQ_MAX_RETRIES=3
DRAMATIQ_MIN_BACKOFF_MS=1000
DRAMATIQ_MAX_BACKOFF_MS=30000

# DeepSeek (set via CI variable in the deploy stage).
DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=30

# CORS: allow the CloudFront dashboard origin (and local dev).
CORS_ORIGINS=https://CHANGE_ME.cloudfront.net,http://localhost:5173

# Error aggregation / retrieval tuning.
ERROR_AGGREGATION_TTL=86400
INVESTIGATION_TTL=3600
RETRIEVAL_MAX_ITEMS=25
RETRIEVAL_MAX_CHARS=12000
